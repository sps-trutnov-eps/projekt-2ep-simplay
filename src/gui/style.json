"QCustomSlideMenu": [{
    "name": "side_menu",
    "defaultSize": [{
        "width": 150,
        "height": "auto"
    }],
    "collapsedSize": [{
        "width": 0,
        "height": 0
    }],
    "expandedSize": [{
        "width": 150,
        "height": "auto"
    }],
    "toggleButton": [{
        "buttonName": "menuBtn",
        "icons": [{
            "whenMenuIsCollapsed": ":/icons/icons/align-left.svg",
            "whenMenuIsExpanded": ":/icons/icons/chevron-left.svg"
        }],
    "menuTransitionAnimation": [{
        "animationDuration": 1000,
        "animationEasingCurve": "OutBack",
        }],
    }],
}]